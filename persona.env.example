# runtime env for the persona container. copy to persona.env (gitignored) and fill in.
# compose loads this via `env_file:` (see docker-compose.yml), so ANY key here reaches the
# container -- and every backend and face hmux spawns inherits it, since nothing clears the
# environment. that makes this file the one place to set a var an agent reads.
#
# every value is optional: leaving one unset idles the related face rather than failing. the
# defaults below are what the code uses when the var is absent, not values that are set for you.
# compose reads this file when it CREATES the container, so a change needs `make down && make up`
# rather than `make restart`.
#
# NAMING: everything hmux owns is HMUX_*. provider vars (OPENAI_*, ANTHROPIC_*, ...) keep their
# standard spellings because the agents read them directly, and PERSONA_* is this repo's own.
#
# the container's SHAPE -- ports, volumes, uid, $DISPLAY -- is not settable here; it is decided
# before the container exists. see the note at the bottom, and docker-compose.yml.

# --- model providers -------------------------------------------------------------------
# read by the agents themselves, not by hmux, so which ones matter depends on the backend: pi
# takes its provider config from the mounted ~/.pi/agent/models.json, while opencode reads these
# from the environment. set the ones your backend uses; unset ones are simply ignored.
# BOTH openai base-url spellings are honored downstream -- tools disagree on which they read,
# and the one that loses is invisible (the model just talks to the wrong host), so set the pair.
#OPENAI_API_KEY=
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_API_BASE=https://api.openai.com/v1
#ANTHROPIC_API_KEY=
#ANTHROPIC_BASE_URL=
#GEMINI_API_KEY=
#GOOGLE_API_KEY=
#OPENROUTER_API_KEY=
#GROQ_API_KEY=
#XAI_API_KEY=
#DEEPSEEK_API_KEY=
#MISTRAL_API_KEY=

# --- the voice face (speech) -----------------------------------------------------------
# the speech stack: it owns stt, sentence chunking, sanitizing and tts, so every client (omni
# web, omni flutter) carries only a mic, a speaker and a local VAD. these also enable
# `/v1/realtime` on the openai face.
#
# unset, the face IDLES (connected but serving no speech) rather than taking the stack down.
# one endpoint usually serves both halves, so HMUX_VOICE_URL is normally the only one you need;
# it falls back to OPENAI_BASE_URL / OPENAI_API_KEY above, so a deployment that already set
# those needs nothing here at all.
#HMUX_VOICE_URL=https://api.openai.com/v1
#HMUX_VOICE_API_KEY=
#HMUX_VOICE_STT_MODEL=whisper-1
#HMUX_VOICE_TTS_MODEL=tts-1
#HMUX_VOICE_TTS_VOICE=alloy
# a SPLIT stack (stt and tts on different hosts) overrides either service, key included:
#HMUX_VOICE_STT_URL=
#HMUX_VOICE_STT_API_KEY=
#HMUX_VOICE_TTS_URL=
#HMUX_VOICE_TTS_API_KEY=
# how much PCM the endpoint batches per streamed event. raise it when the tts server generates
# slower than realtime: a small batch starves the client's playout and the speech turns choppy.
#HMUX_VOICE_TTS_STREAM_BATCH=8
# a spoken-reply note appended to the system prompt of turns the voice face drives. empty = off.
#HMUX_VOICE_SYSTEM_PROMPT=

# --- the matrix bridge face ------------------------------------------------------------
# set the first three to connect; unset -> the bridge idles. the access token is a SECRET --
# keep it here, never in the compose file or on argv. run the HOST-side helper
# (scripts/matrix-login) to write HMUX_BRIDGE_USER_ID + HMUX_BRIDGE_ACCESS_TOKEN here.
#HMUX_BRIDGE_HOMESERVER=https://matrix.example.org
#HMUX_BRIDGE_USER_ID=@per:example.org
#HMUX_BRIDGE_ACCESS_TOKEN=
# which agent bridged turns run as.
#HMUX_BRIDGE_AGENT=per
# when to answer in a NON-DM room: `mention` (only when addressed) or `all`. DMs always answer.
#HMUX_BRIDGE_DEFAULT_TRIGGER=mention
# pin bridged turns to one model, as `provider/model`. unset = the session default.
#HMUX_BRIDGE_MODEL=
# comma-separated room ids. a non-empty allowlist is exclusive; the blocklist always wins.
#HMUX_BRIDGE_ROOM_ALLOWLIST=
#HMUX_BRIDGE_ROOM_BLOCKLIST=
# comma-separated matrix users whose reply may answer a permission prompt relayed to a room.
#HMUX_BRIDGE_PERMISSION_USERS=
# read by scripts/matrix-login only, to avoid a password on argv or in shell history.
#HMUX_BRIDGE_PASSWORD=

# --- the hcp face (traits, hooks, heartbeat) --------------------------------------------
# force the heartbeat off for this deployment regardless of what the agent has persisted.
# unset = on, and the agent's own hcp_heartbeat_set decides the cadence. the eval sets false.
#HMUX_HCP_HEARTBEAT_ENABLED=true

# --- hub + clients -----------------------------------------------------------------------
# give the MODEL the cross-session inject/list tools (hmux_inject, hmux_sessions). off unless set.
#HMUX_AGENT_TOOLS=
#
# ANY knob in hmux/config.toml can be set from here instead, by the path it has in that file:
# HMUX_CFG_<path> with `__` between segments, clients addressed by KIND. a mistyped path fails
# loudly at startup rather than setting nothing, and every override is printed. a path whose table
# does not exist yet is CREATED, so this reaches settings the file never mentions.
#
# this is how a DEPLOYMENT should differ from the checkout: hmux/config.toml stays byte-identical
# and the host-specific opt-ins live here, so neither file has to be merged when the other moves.
#
#   put persona.py's forty-odd tools BEHIND hcp_tool_list + hcp_tool_invoke instead of naming each
#   one in every request. the config ships "add" (both routes, which is what makes a tool Per just
#   wrote callable in the same session); "only" is the context saving, and wants an eval first
#HMUX_CFG_profile__persona__faces__hcp__dynamic_tools=only
#   stop re-discovering Per's tools after it edits its own hook (the config ships this ON)
#HMUX_CFG_profile__persona__faces__hcp__reload_tools=false
#   let Per read and change the permission policy at runtime (asks a human for each change; a
#   restart restores hmux/config.toml)
#HMUX_CFG_profile__persona__faces__permission__tools=true
#
# NOT settable here: HMUX_FACE_PREFERENCES / HMUX_HARNESS_PREFERENCES. `hmux up` sets both when
# it launches the hub, from the profile's `clients` and `backends` order (hmux/config.toml), so a
# value in this file is overwritten. change the profile order instead.

# --- NOT here: the container's shape ----------------------------------------------------
# published ports, where /work and /data live, the uid/gid, $DISPLAY. those appear as `${VAR}`
# in docker-compose.yml, and compose interpolates them from your SHELL before the container
# exists -- never from an env_file, which it hands to the container only after deciding all of
# that. they were listed here once and did nothing at all. set them in the shell (as the eval
# does with PERSONA_HUB_PORT) or edit docker-compose.yml, where each has a comment.
